# Database
DATABASE_URL=postgresql://user:password@localhost:5432/research_chat_platform
# TLS certificate verification is ON by default for SSL connections.
# If your provider's certificate does not validate, supply the CA certificate (PEM):
# DATABASE_CA_CERT=
# Or, as a last resort only, disable verification:
# DATABASE_SSL_NO_VERIFY=true

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional: override the chat model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS
FRONTEND_URL=http://localhost:5173

# Admin API (for data access)
# REQUIRED for the admin dashboard/endpoints: if unset, the admin API is disabled
# entirely (fails closed — there is no fallback key and no development bypass).
# Use a strong random value, e.g.: openssl rand -hex 32
ADMIN_API_KEY=your-admin-api-key-here-change-in-production
