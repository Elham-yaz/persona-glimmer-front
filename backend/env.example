# ---------------------------------------------------------------------------
# Study 2 backend — environment variables (copy to .env for local development)
# ---------------------------------------------------------------------------

# Database (REQUIRED)
DATABASE_URL=postgresql://localhost:5432/persona_glimmer_dev
# TLS certificate verification is ON by default for SSL connections (Render / production).
# If your provider's certificate does not validate, supply the CA certificate (PEM):
# DATABASE_CA_CERT=
# Or, as a last resort only, disable verification:
# DATABASE_SSL_NO_VERIFY=true

# OpenAI (REQUIRED unless MOCK_OPENAI=true)
OPENAI_API_KEY=sk-your-openai-api-key-here
# Chat model stamped onto each session (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Return deterministic replies without calling OpenAI (tests / local dev only)
# MOCK_OPENAI=false

# Admin API (REQUIRED). The admin dashboard/endpoints are disabled entirely if unset
# (fails closed — there is no fallback key and no development bypass).
# Use a strong random value, e.g.: openssl rand -hex 32
ADMIN_API_KEY=your-admin-api-key-here-change-in-production

# Study behaviour
# random   = uniform over the 12 (agent x context) cells (default)
# balanced = uniform among the cells with the fewest started sessions
# ASSIGNMENT_MODE=random
# When true, POST /api/sessions honors { force: { agentConditionId, contextId } } (dev/test/pilot only)
# ALLOW_FORCED_ASSIGNMENT=false
# Disable all rate limits (tests only)
# DISABLE_RATE_LIMITS=false
# Per-IP cap on new sessions per hour (default 60). Raise it if many participants will
# start the study from one shared public IP (computer lab, campus network) within an hour.
# SESSION_CREATE_LIMIT_PER_HOUR=60
# Per-session cap on messages per minute (default 30).
# MESSAGE_LIMIT_PER_MINUTE=30

# Server
PORT=3000
NODE_ENV=development

# CORS: exact-match origin of the deployed frontend (any localhost port is allowed outside production)
FRONTEND_URL=http://localhost:8080
