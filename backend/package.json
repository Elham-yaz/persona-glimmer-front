{
  "name": "research-chat-platform-backend",
  "version": "2.0.0",
  "description": "Backend API for the Study 2 single-session research chat platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm install --include=dev",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrations/run-migrations.ts",
    "seed": "tsx src/seeds/run-seeds.ts",
    "db:reset": "tsx src/migrations/reset-database.ts",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src tests --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "openai": "^4.20.1",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  }
}
